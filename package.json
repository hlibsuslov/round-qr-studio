{
  "name": "round-qr-studio",
  "version": "0.1.0",
  "description": "Privacy-friendly shaped QR code generator with scan-safe PNG and SVG exports.",
  "private": true,
  "license": "MIT",
  "homepage": "https://round-qr-studio-hlib.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlibsuslov/round-qr-studio.git"
  },
  "bugs": {
    "url": "https://github.com/hlibsuslov/round-qr-studio/issues"
  },
  "keywords": [
    "qr-code",
    "qr-generator",
    "react",
    "typescript",
    "svg"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@iconify/react": "^6.0.2",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "1.5.2",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "jsqr": "1.4.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.2",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
